// Buddget — personal budgeting app
// Prisma schema: NextAuth models + budgeting domain models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- NextAuth (Auth.js) models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // bcrypt hash, for email/password (credentials) login
  currency      String    @default("IDR")
  // Rotated by "reset all data" — tells mobile clients to wipe and do a full pull.
  syncEpoch     String    @default(cuid())

  accounts           Account[]
  sessions           Session[]
  wallets            Wallet[]
  categories         Category[]
  transactions       Transaction[]
  budgets            Budget[]
  subscriptions      Subscription[]
  planned            PlannedTransaction[]
  prayers            PrayerEntry[]
  health             HealthEntry[]
  foodLogs           FoodLog[]
  tombstones         SyncTombstone[]
  taskAreas          TaskArea[]
  tasks              Task[]
  notes              Note[]
  noteLabels         NoteLabel[]
  socialAccounts     SocialAccount[]
  contentItems       ContentItem[]
  contentPosts       ContentPost[]
  contentPillars     ContentPillar[]
  habits             Habit[]
  habitLogs          HabitLog[]
  assets             Asset[]
  assetTrades        AssetTrade[]
  portfolioSnapshots PortfolioSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Budgeting domain models ----------

// A wallet / account holding money (cash, bank, e-wallet, credit card...)
model Wallet {
  id       String   @id @default(cuid())
  userId   String
  name     String
  type     String   @default("cash") // cash | bank | ewallet | credit | savings | investment
  balance  Float    @default(0)
  currency String   @default("IDR")
  color    String   @default("#6366f1")
  icon     String   @default("wallet")
  archived Boolean  @default(false)
  // Last time the wallet's own fields were edited (not bumped by balance changes).
  // Used for last-write-wins in mobile sync, since `updatedAt` moves with every transaction.
  editedAt DateTime @default(now())

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]        @relation("WalletTransactions")
  transfersIn   Transaction[]        @relation("WalletTransfersIn")
  subscriptions Subscription[]
  planned       PlannedTransaction[]
  tasks         Task[]
  assets        Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Category {
  id     String @id @default(cuid())
  userId String
  name   String
  type   String @default("expense") // expense | income
  color  String @default("#6366f1")
  icon   String @default("circle")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  budgets       Budget[]
  subscriptions Subscription[]
  planned       PlannedTransaction[]
  tasks         Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  walletId   String
  toWalletId String? // destination wallet for type = transfer
  categoryId String?
  type       String   @default("expense") // expense | income | transfer | adjustment | investment
  amount     Float // > 0, except adjustment/investment: signed, non-zero (docs/balance-adjustment.md, docs/investments.md)
  note       String?
  date       DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet     Wallet      @relation("WalletTransactions", fields: [walletId], references: [id], onDelete: Cascade)
  toWallet   Wallet?     @relation("WalletTransfersIn", fields: [toWalletId], references: [id], onDelete: SetNull)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tasks      Task[]
  notes      Note[]
  assetTrade AssetTrade?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // JSON array of relative upload URLs (/uploads/<name>.<ext>), max 5, display order
  // (docs/transaction-photos.md). Last column so the migration is a plain ADD COLUMN.
  photos String @default("[]")

  @@index([userId])
  @@index([walletId])
  @@index([categoryId])
  @@index([date])
}

// Monthly budget per category
model Budget {
  id         String @id @default(cuid())
  userId     String
  categoryId String
  amount     Float
  month      Int // 1-12
  year       Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
  @@index([userId])
}

// A recurring subscription (Netflix, Spotify, gym, ...) — tracking only.
model Subscription {
  id          String   @id @default(cuid())
  userId      String
  name        String
  amount      Float
  currency    String   @default("IDR")
  cycle       String   @default("monthly") // weekly | monthly | yearly
  nextBilling DateTime
  categoryId  String?
  walletId    String? // the payment method (which wallet it's billed to)
  color       String   @default("#6366f1")
  icon        String   @default("credit-card")
  note        String?
  active      Boolean  @default(true)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  wallet   Wallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// A user-entered expectation of a future transaction — a forecast/planning note.
// Unlike Transaction, this NEVER touches a wallet balance; it's purely a projection.
model PlannedTransaction {
  id         String   @id @default(cuid())
  userId     String
  type       String   @default("expense") // expense | income
  amount     Float
  note       String?
  categoryId String?
  walletId   String? // optional tag for which wallet it's expected from
  date       DateTime // expected date
  done       Boolean  @default(false) // user ticked it off as having happened

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  wallet   Wallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([date])
}

// A recorded prayer (docs/prayer-quality.md). A row = the user recorded something for
// that prayer that day; no row = not filled in yet.
model PrayerEntry {
  id       String    @id @default(cuid())
  userId   String
  date     String // local date as YYYY-MM-DD
  prayer   String // fardhu: subuh|dzuhur|ashar|maghrib|isya · sunnah: dhuha|tahajud|witir
  status   String    @default("ontime") // fardhu: masjid|jamaah|ontime|late|qadha|missed|excused · sunnah: done
  qobliyah Boolean   @default(false) // rawatib before (fardhu rows only, where it exists)
  badiyah  Boolean   @default(false) // rawatib after (fardhu rows only, where it exists)
  rakaat   Int? // sunnah rows only, optional
  prayedAt DateTime? // optional: when it was prayed
  note     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, date, prayer])
  @@index([userId, date])
}

// A health measurement (body weight and/or blood pressure) at a point in time.
model HealthEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  weight    Float? // kg
  systolic  Int? // mmHg
  diastolic Int? // mmHg
  pulse     Int? // bpm
  note      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

// A logged meal/food item, with an optional photo, calories and note.
model FoodLog {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime @default(now())
  name     String
  meal     String? // breakfast | lunch | dinner | snack
  calories Int?
  photoUrl String?
  note     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

// ---------- Tasks (docs/tasks.md) ----------

// A life context for tasks (Kerjaan, Keseharian, …) with an optional active schedule.
model TaskArea {
  id        String  @id @default(cuid())
  userId    String
  name      String // 1–40 chars
  code      String // 1–8 chars, A–Z 0–9, unique per user (notification prefix)
  color     String  @default("#58CC02")
  icon      String  @default("briefcase") // same icon set as categories
  schedule  String? // JSON {"days":[1..7],"start":"HH:mm","end":"HH:mm"}; null = anytime
  sortOrder Int     @default(0)
  archived  Boolean @default(false)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, code])
  @@index([userId])
}

// A to-do item in an area and a FIRE/WANT/SHOULD bucket.
model Task {
  id            String    @id @default(cuid())
  userId        String
  areaId        String
  title         String // 1–200 chars
  note          String? // ≤ 2000
  bucket        String    @default("want") // fire | want | should
  dueDate       String? // local date YYYY-MM-DD
  dueTime       String? // local HH:mm, only with dueDate
  remindBefore  Int? // minutes before due (0 = at due time); null = no reminder
  recurrence    String? // JSON {"freq","interval","weekdays"?,"monthDay"?}; null = one-off
  seriesId      String? // same for every occurrence of a recurring task (= first occurrence's id)
  done          Boolean   @default(false)
  doneAt        DateTime?
  sortOrder     Float     @default(0) // manual order within (area, bucket)
  amount        Float? // optional money link (> 0)
  walletId      String?
  categoryId    String?
  transactionId String? // the expense recorded when completing

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        TaskArea     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  wallet      Wallet?      @relation(fields: [walletId], references: [id], onDelete: SetNull)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  notes       Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, done])
  @@index([userId, dueDate])
  @@index([areaId])
}

// ---------- Notes (docs/notes.md) ----------

// A Keep-like note. JSON columns are validated by src/lib/notes.ts and travel as JSON
// values on the sync wire.
model Note {
  id                  String   @id @default(cuid())
  userId              String
  title               String? // ≤ 200
  body                String   @default("") // Markdown subset, ≤ 50 000 chars
  checklist           String   @default("[]") // JSON [{id, text, done}] (≤ 200)
  labels              String   @default("[]") // JSON array of NoteLabel ids
  color               String? // palette id (NOTE_COLORS), null = default
  pinned              Boolean  @default(false)
  archived            Boolean  @default(false)
  photos              String   @default("[]") // JSON array of /uploads image URLs (≤ 10)
  audio               String   @default("[]") // JSON [{url, durationSec, transcript}] (≤ 5)
  links               String   @default("[]") // JSON [{url, title}] (≤ 20)
  source              String? // share | quick | voice | null
  linkedTaskId        String?
  linkedContentId     String?
  linkedTransactionId String?
  // Last user edit (web or sync). Server-only, not on the wire: the last-write-wins time,
  // because `updatedAt` also moves when the server fills link titles or strips a label.
  editedAt            DateTime @default(now())

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedTask        Task?         @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)
  linkedContent     ContentItem?  @relation("NoteLinkedContent", fields: [linkedContentId], references: [id], onDelete: SetNull)
  linkedTransaction Transaction?  @relation(fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  contentItems      ContentItem[] @relation("ContentSourceNote")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([linkedTaskId])
  @@index([linkedContentId])
  @@index([linkedTransactionId])
}

model NoteLabel {
  id        String  @id @default(cuid())
  userId    String
  name      String // 1–30, unique per user (case-insensitive, checked in code)
  color     String  @default("#58CC02")
  pinnedTab Boolean @default(false) // shown as a tab
  sortOrder Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

// ---------- Content planner (docs/content.md) ----------

model SocialAccount {
  id            String  @id @default(cuid())
  userId        String
  platform      String // instagram | tiktok | youtube | x | threads | linkedin | facebook | other
  platformName  String? // display name when platform = other
  handle        String // ≤ 60
  color         String
  targetPerWeek Int? // posting goal per ISO week, null = none
  archived      Boolean @default(false)
  sortOrder     Int     @default(0)

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts ContentPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ContentItem {
  id         String  @id @default(cuid())
  userId     String
  title      String // ≤ 200
  stage      String  @default("ide") // ide | naskah | produksi | siap | terjadwal | tayang
  format     String? // post | carousel | reel | story | video | short | thread | live | other
  pillar     String? // ContentPillar name
  idea       String  @default("") // markdown, ≤ 50 000
  noteId     String? // source note
  checklist  String  @default("[]") // JSON [{id, text, done}]
  photos     String  @default("[]") // JSON /uploads image URLs (≤ 10)
  assetLinks String  @default("[]") // JSON [{url, label}] (≤ 20)
  sponsor    String? // JSON {brand, amount, currency, due, paid, transactionId} or null

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  note        Note?         @relation("ContentSourceNote", fields: [noteId], references: [id], onDelete: SetNull)
  posts       ContentPost[]
  linkedNotes Note[]        @relation("NoteLinkedContent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([noteId])
}

// One per target account (the "variant") of a content item.
model ContentPost {
  id           String    @id @default(cuid())
  userId       String
  contentId    String
  accountId    String
  caption      String    @default("") // ≤ 5000
  hashtags     String    @default("") // ≤ 1000
  scheduledAt  DateTime?
  remindBefore Int? // minutes; null = no reminder
  status       String    @default("draft") // draft | scheduled | posted | skipped
  postedAt     DateTime?
  url          String?
  metrics      String    @default("{}") // JSON {views, likes, comments, shares, saves, followers}
  metricsAt    DateTime?

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content ContentItem   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, scheduledAt])
  @@index([contentId])
  @@index([accountId])
}

model ContentPillar {
  id        String @id @default(cuid())
  userId    String
  name      String // 1–30, unique per user (case-insensitive, checked in code)
  color     String @default("#58CC02")
  sortOrder Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

// ---------- Habits (docs/habits.md) ----------

// A habit to build (olahraga, baca buku) or to quit (rokok, begadang). JSON columns are
// validated by src/lib/habits.ts and travel as JSON values on the sync wire.
model Habit {
  id        String  @id @default(cuid())
  userId    String
  name      String // 1–60
  emoji     String? // one emoji, optional
  color     String  @default("#58CC02")
  kind      String  @default("build") // build | quit
  schedule  String  @default("{\"type\":\"daily\"}") // JSON {"type":"daily"} | {"type":"weekdays","days":[1..7]} | {"type":"perWeek","times":1..7}
  target    String  @default("{\"type\":\"check\"}") // JSON {"type":"check"} | {"type":"count","goal","unit"} | {"type":"duration","goal"}
  reminders String  @default("[]") // JSON ["07:00", …] local HH:mm, ≤ 5
  private   Boolean @default(false) // masked outside the Habits screen
  why       String? // ≤ 500 — "alasan" shown on the emergency screen
  startDate String // YYYY-MM-DD; streaks count from here
  archived  Boolean @default(false)
  sortOrder Int     @default(0)

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// One row per habit / local day / type (done | skip | relapse | urge).
model HabitLog {
  id       String    @id @default(cuid())
  userId   String
  habitId  String
  date     String // local YYYY-MM-DD
  type     String // done | skip | relapse | urge
  value    Float? // done: progress (1 for check); relapse/urge: count that day; skip: null
  note     String? // ≤ 1000 — journal
  triggers String    @default("[]") // JSON ["bosan","stres", …] ≤ 10 (relapse/urge only)
  at       DateTime? // when it happened (relapse/urge time of day)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId, date, type])
  @@index([userId, updatedAt])
  @@index([userId, date])
}

// ---------- Investments (docs/investments.md) ----------

// An instrument the user holds or watches. Holdings are derived from its trades.
model Asset {
  id            String    @id @default(cuid())
  userId        String
  kind          String // stock | fund | gold | crypto | bond | other
  symbol        String // stock: IDX ticker "BBCA"; crypto: "BTC"; others: free code ≤ 20
  name          String?
  currency      String    @default("IDR")
  priceMode     String    @default("auto") // auto (stock/crypto only) | manual
  manualPrice   Float? // per unit, when priceMode = manual
  manualPriceAt DateTime?
  unit          String    @default("lembar") // lembar | unit | gram | koin | …
  walletId      String? // the investment wallet / RDN
  archived      Boolean   @default(false)
  sortOrder     Int       @default(0)

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet?      @relation(fields: [walletId], references: [id], onDelete: SetNull)
  trades AssetTrade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind, symbol])
  @@index([userId, updatedAt])
}

model AssetTrade {
  id                String   @id @default(cuid())
  userId            String
  assetId           String
  type              String // buy | sell | dividend | split | fee
  date              DateTime
  quantity          Float? // buy/sell: units (shares, not lots)
  price             Float? // buy/sell: per unit
  fee               Float    @default(0) // buy/sell: broker fee + tax
  amount            Float? // dividend: cash received; fee: the fee
  ratio             Float? // split: new units per old unit
  note              String?
  cashTransactionId String?  @unique // the linked wallet transaction (investment / dividend income)

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset           Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  cashTransaction Transaction? @relation(fields: [cashTransactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([assetId, date])
}

// Latest market price per instrument, shared across users (not user data, not synced).
model SecurityPrice {
  id        String    @id @default(cuid())
  kind      String // stock | crypto
  symbol    String // BBCA, BTC
  name      String?
  price     Float
  prevClose Float?
  change    Float?
  changePct Float?
  currency  String    @default("IDR")
  asOf      DateTime // market time of the price
  source    String    @default("yahoo")
  fetchedAt DateTime // last successful fetch
  checkedAt DateTime? // last attempt (success or failure)
  error     String? // last failure, null after a success

  @@unique([kind, symbol])
}

// Daily portfolio value for the history chart (server-only, not synced).
model PortfolioSnapshot {
  id     String @id @default(cuid())
  userId String
  date   String // local YYYY-MM-DD (Asia/Jakarta)
  value  Float // market value
  cost   Float // cost basis

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// ---------- Mobile sync ----------

// Record of a deleted synced row, so mobile clients can drop it on their next pull.
// `entity` is the sync wire name (wallets, transactions, ...). Written by src/lib/sync-deletes.ts.
model SyncTombstone {
  id        String   @id @default(cuid())
  userId    String
  entity    String
  entityId  String
  deletedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@index([userId, entity, entityId])
}
