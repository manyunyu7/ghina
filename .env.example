# Database
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Mobile app Google sign-in: extra OAuth client ids (Android/iOS) accepted as ID-token audience, comma-separated
AUTH_GOOGLE_MOBILE_CLIENT_IDS=""

# Killa — personal Claude agent (docs/killa.md). killa-engine must run on the same host.
KILLA_BASE_URL="http://127.0.0.1:8377"
KILLA_TOKEN=""
# Emails allowed to use Killa (web + mobile), comma-separated; empty = nobody
KILLA_ALLOWED_EMAILS=""
